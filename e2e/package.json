{
  "name": "chargeback-os-e2e",
  "private": true,
  "type": "module",
  "description": "Chrome browser tests for Chargeback OS. Standalone: not part of the pnpm workspace.",
  "scripts": {
    "tunnel": "ssh -o ExitOnForwardFailure=yes -f -N -L 18080:localhost:80 replit",
    "test": "playwright test",
    "test:unit": "playwright test --project=unit",
    "test:ui": "playwright test --project=ui",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "typescript": "~5.9.3"
  }
}
